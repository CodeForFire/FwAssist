<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- The look of the seven drawings: token colours only, and hatches and words where a colour alone
       would have to carry a meaning (AGENTS.md, "Mobile"). -->

  <!-- Text -->
  <Style Selector="Canvas TextBlock">
    <Setter Property="FontSize" Value="14" />
    <Setter Property="FontWeight" Value="Medium" />
    <Setter Property="TextWrapping" Value="NoWrap" />
  </Style>
  <Style Selector="Canvas TextBlock.d-head">
    <Setter Property="FontFamily" Value="{DynamicResource DisplayFont}" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
  </Style>
  <Style Selector="Canvas TextBlock.d-small">
    <Setter Property="FontSize" Value="13" />
    <Setter Property="FontWeight" Value="Normal" />
  </Style>
  <Style Selector="Canvas TextBlock.d-danger">
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="Foreground" Value="{DynamicResource SignalHotBrush}" />
  </Style>

  <!-- Areas -->
  <Style Selector="Path.d-zone">
    <Setter Property="Fill" Value="{DynamicResource SurfaceTopBrush}" />
    <Setter Property="Stroke" Value="{DynamicResource BorderStrongBrush}" />
    <Setter Property="StrokeThickness" Value="1" />
    <Setter Property="StrokeDashArray" Value="4,3" />
  </Style>
  <Style Selector="Path.d-site">
    <Setter Property="Fill" Value="{DynamicResource SurfaceBrush}" />
    <Setter Property="Stroke" Value="{DynamicResource TextPrimaryBrush}" />
    <Setter Property="StrokeThickness" Value="2" />
  </Style>
  <Style Selector="Path.d-danger">
    <Setter Property="Fill" Value="{DynamicResource SignalWashBrush}" />
    <Setter Property="Stroke" Value="{DynamicResource SignalBrush}" />
    <Setter Property="StrokeThickness" Value="2" />
    <Setter Property="StrokeDashArray" Value="5,3" />
  </Style>
  <Style Selector="Path.d-danger-line">
    <Setter Property="Stroke" Value="{DynamicResource AmberBrush}" />
    <Setter Property="StrokeThickness" Value="2" />
    <Setter Property="StrokeDashArray" Value="5,3" />
  </Style>
  <Style Selector="Path.d-tail">
    <Setter Property="Fill" Value="{DynamicResource SignalDeepBrush}" />
    <Setter Property="Opacity" Value="0.75" />
  </Style>
  <Style Selector="Path.d-hill">
    <Setter Property="Fill" Value="{DynamicResource SurfaceTopBrush}" />
  </Style>
  <Style Selector="Path.d-road">
    <Setter Property="Fill" Value="{DynamicResource SurfaceTopBrush}" />
  </Style>
  <Style Selector="Path.d-beam">
    <Setter Property="Fill" Value="{DynamicResource AmberBrush}" />
    <Setter Property="Opacity" Value="0.4" />
  </Style>

  <!-- Lines -->
  <Style Selector="Path.d-line, Path.d-slope, Path.d-ground">
    <Setter Property="Stroke" Value="{DynamicResource TextPrimaryBrush}" />
    <Setter Property="StrokeThickness" Value="2" />
  </Style>
  <Style Selector="Path.d-dim, Path.d-soft">
    <Setter Property="Stroke" Value="{DynamicResource TextSecondaryBrush}" />
    <Setter Property="StrokeThickness" Value="1.5" />
  </Style>
  <Style Selector="Path.d-roadline">
    <Setter Property="Stroke" Value="{DynamicResource TextSecondaryBrush}" />
    <Setter Property="StrokeThickness" Value="1" />
  </Style>
  <Style Selector="Path.d-roaddash">
    <Setter Property="Stroke" Value="{DynamicResource TextSecondaryBrush}" />
    <Setter Property="StrokeThickness" Value="1" />
    <Setter Property="StrokeDashArray" Value="8,8" />
  </Style>
  <Style Selector="Path.d-arrow">
    <Setter Property="Stroke" Value="{DynamicResource IncomingBrush}" />
    <Setter Property="StrokeThickness" Value="2.5" />
  </Style>
  <Style Selector="Path.d-wind">
    <Setter Property="Stroke" Value="{DynamicResource TextSecondaryBrush}" />
    <Setter Property="StrokeThickness" Value="2.5" />
  </Style>
  <Style Selector="Path.d-go">
    <Setter Property="Stroke" Value="{DynamicResource ActiveBrush}" />
    <Setter Property="StrokeThickness" Value="3" />
  </Style>
  <Style Selector="Path.d-rotor">
    <Setter Property="Stroke" Value="{DynamicResource TextPrimaryBrush}" />
    <Setter Property="StrokeThickness" Value="5" />
  </Style>
  <Style Selector="Path.d-cross">
    <Setter Property="Stroke" Value="{DynamicResource TextPrimaryBrush}" />
    <Setter Property="StrokeThickness" Value="4" />
  </Style>

  <!-- Things -->
  <Style Selector="Path.d-lamp, Path.d-mark">
    <Setter Property="Fill" Value="{DynamicResource AmberBrush}" />
    <Setter Property="Stroke" Value="{DynamicResource AmberInkBrush}" />
    <Setter Property="StrokeThickness" Value="1" />
  </Style>
  <Style Selector="Path.d-blue">
    <Setter Property="Fill" Value="{DynamicResource IncomingBrush}" />
  </Style>
  <Style Selector="Path.d-car, Path.d-mast, Path.d-obstacle">
    <Setter Property="Fill" Value="{DynamicResource TextSecondaryBrush}" />
  </Style>
  <Style Selector="Path.d-person">
    <Setter Property="Fill" Value="{DynamicResource TextPrimaryBrush}" />
    <Setter Property="Data" Value="M6,0 A4,4 0 1 0 6,8 A4,4 0 1 0 6,0 Z M0,22 C0,6 12,6 12,22 Z" />
  </Style>

  <!-- A helicopter from above, nose up, with crossed rotor blades and a long tail boom. -->
  <Style Selector="Path.d-heli">
    <Setter Property="Fill" Value="{DynamicResource TextPrimaryBrush}" />
    <Setter Property="Data" Value="F1 M50,26 C58,26 60,34 60,42 L60,60 C60,66 53,70 52,71 L51.5,122 L60,122 L60,126 L40,126 L40,122 L48.5,122 L48,71 C47,70 40,66 40,60 L40,42 C40,34 42,26 50,26 Z M10,14 L14,10 L90,86 L86,90 Z M86,10 L90,14 L14,90 L10,86 Z" />
  </Style>
  <!-- A helicopter from the side, without its rotor: on a slope the rotor is drawn level on its own. -->
  <Style Selector="Path.d-heli-body">
    <Setter Property="Fill" Value="{DynamicResource TextPrimaryBrush}" />
    <Setter Property="Data" Value="M11,6 H13 V8 H15 C18,8 19,11 19.5,12 H23 V9 H24 V16 H23 V14 H19 C18,17 15,18 12,18 H6 C3,18 2,15 2,13 C2,10 4,8 7,8 H11 Z M6,18 H7 V20 H6 Z M14,18 H15 V20 H14 Z M4,20 H18 V22 H4 Z" />
  </Style>
</Styles>
