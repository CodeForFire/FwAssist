<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Helfer.Helpers.RthLandeplatz;assembly=Helfer.Helpers.RthLandeplatz"
             x:Class="Helfer.Helpers.RthLandeplatz.Ui.Drawings.RotorUeberStrasseDrawing"
             x:DataType="vm:SiteDrawing">
  <!-- Our own plan, new work from the figures on Folie 26. They fit the H145 only, so the drawing says it is an example. -->
  <Viewbox Stretch="Uniform">
    <Canvas Width="360" Height="236">
      <TextBlock Classes="d-head" Canvas.Left="0" Canvas.Top="0" Text="Beispiel H145, von oben" />
      <Path Classes="d-road" Data="M0,28 H360 V154 H0 Z" />
      <Path Classes="d-roadline" Data="M0,40 H360 M0,142 H360" />
      <Path Classes="d-roaddash" Data="M0,91 H360" />
      <Path Classes="d-danger" Data="M84,103 A66,66 0 1 0 216,103 A66,66 0 1 0 84,103 Z" />
      <Path Classes="d-heli" Canvas.Left="82.5" Canvas.Top="35.5" Width="93" Height="135" Stretch="Uniform" RenderTransform="rotate(90deg)" />
      <Path Classes="d-dim" Data="M84,177 V187 M84,182 H216 M216,177 V187" />
      <TextBlock Classes="d" Canvas.Left="84" Canvas.Top="188" Width="132" TextAlignment="Center" Text="Rotor 11,00 m" />
      <Path Classes="d-dim" Data="M235,28 H245 M240,28 V154 M235,154 H245" />
      <TextBlock Classes="d" Canvas.Left="248" Canvas.Top="54" Text="Straße 10,50 m" />
      <TextBlock Classes="d-small" Canvas.Left="248" Canvas.Top="72" Text="2 Fahrstreifen und" />
      <TextBlock Classes="d-small" Canvas.Left="248" Canvas.Top="88" Text="Seitenstreifen" />
      <TextBlock Classes="d-danger" Canvas.Left="0" Canvas.Top="214" Width="360" TextAlignment="Center" Text="Der Rotor reicht über den Fahrbahnrand." />
    </Canvas>
  </Viewbox>
</UserControl>
