<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Helfer.Helpers.RthLandeplatz;assembly=Helfer.Helpers.RthLandeplatz"
             x:Class="Helfer.Helpers.RthLandeplatz.Ui.Drawings.LichtkreuzDrawing"
             x:DataType="vm:SiteDrawing">
  <!-- Our own plan, new work from the facts in vfdb 4.5. -->
  <Viewbox Stretch="Uniform">
    <Canvas Width="360" Height="266">
      <TextBlock Classes="d" Canvas.Left="90" Canvas.Top="8" Width="180" TextAlignment="Center" Text="Landepunkt" />
      <TextBlock Classes="d-small" Canvas.Left="90" Canvas.Top="26" Width="180" TextAlignment="Center" Text="Abblendlicht über Kreuz" />
      <Path Classes="d-beam" Data="M58,190 L212,72 L232,100 Z" />
      <Path Classes="d-beam" Data="M302,190 L148,72 L128,100 Z" />
      <Path Classes="d-mark" Data="M172,86 A8,8 0 1 0 188,86 A8,8 0 1 0 172,86 Z" />
      <Path Classes="d-car" Data="M34,184 L58,166 L76,190 L52,208 Z" />
      <Path Classes="d-car" Data="M326,184 L302,166 L284,190 L308,208 Z" />
      <TextBlock Classes="d-small" Canvas.Left="16" Canvas.Top="212" Text="Kfz" />
      <TextBlock Classes="d-small" Canvas.Left="320" Canvas.Top="212" Text="Kfz" />
      <Path Classes="d-arrow" Data="M180,204 L180,106 M183.9,114.1 L180,106 L176.1,114.1" />
      <TextBlock Classes="d-small" Canvas.Left="190" Canvas.Top="176" Text="Anflug" />
      <Path Classes="d-dim" Data="M55,233 V243 M55,238 H305 M305,233 V243" />
      <TextBlock Classes="d" Canvas.Left="55" Canvas.Top="244" Width="250" TextAlignment="Center" Text="35 bis 50 m" />
    </Canvas>
  </Viewbox>
</UserControl>
