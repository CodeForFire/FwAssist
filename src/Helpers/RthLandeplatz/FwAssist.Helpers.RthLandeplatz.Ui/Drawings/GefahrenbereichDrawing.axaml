<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:FwAssist.Helpers.RthLandeplatz;assembly=FwAssist.Helpers.RthLandeplatz"
             x:Class="FwAssist.Helpers.RthLandeplatz.Ui.Drawings.GefahrenbereichDrawing"
             x:DataType="vm:SiteDrawing">
  <!-- Our own plan, new work from the facts in ADAC and vfdb 4.7. The words and the cross carry the danger, not only the colour. -->
  <Viewbox Stretch="Uniform">
    <Canvas Width="360" Height="346">
      <TextBlock Classes="d" Canvas.Left="40" Canvas.Top="0" Width="280" TextAlignment="Center" Text="Gefahrenbereich: Rotorkreis" />
      <Path Classes="d-danger" Data="M80,124 A100,100 0 1 0 280,124 A100,100 0 1 0 80,124 Z" />
      <Path Classes="d-tail" Data="M180,170 L128,300 H232 Z" />
      <Path Classes="d-heli" Canvas.Left="109" Canvas.Top="53" Width="142" Height="205" Stretch="Uniform" />
      <TextBlock Classes="d-small" Canvas.Left="150" Canvas.Top="58" Width="60" TextAlignment="Center" Text="vorn" />
      <Path Classes="d-cross" Data="M168,274 L192,298 M192,274 L168,298" />
      <TextBlock Classes="d-danger" Canvas.Left="70" Canvas.Top="306" Width="220" TextAlignment="Center" Text="Heck: Lebensgefahr" />
      <TextBlock Classes="d-danger" Canvas.Left="70" Canvas.Top="324" Width="220" TextAlignment="Center" Text="Nie von hinten" />
      <Path Classes="d-go" Data="M8,124 L72,124 M63.9,127.9 L72,124 L63.9,120.1" />
      <Path Classes="d-go" Data="M352,124 L288,124 M296.1,120.1 L288,124 L296.1,127.9" />
      <TextBlock Classes="d-small" Canvas.Left="2" Canvas.Top="64" Text="Im Blickfeld" />
      <TextBlock Classes="d-small" Canvas.Left="2" Canvas.Top="80" Text="des Piloten" />
      <TextBlock Classes="d-small" Canvas.Left="284" Canvas.Top="64" Text="Im Blickfeld" />
      <TextBlock Classes="d-small" Canvas.Left="284" Canvas.Top="80" Text="des Piloten" />
      <Path Classes="d-lamp" Data="M183,102 A5,5 0 1 0 193,102 A5,5 0 1 0 183,102 Z" />
      <Path Classes="d-soft" Data="M292,206 L196,110 M202.6,112.3 L196,110 L198.3,116.6" />
      <TextBlock Classes="d-small" Canvas.Left="296" Canvas.Top="206" Text="Pilot" />
      <TextBlock Classes="d-small" Canvas.Left="296" Canvas.Top="222" Text="rechts" />
    </Canvas>
  </Viewbox>
</UserControl>
