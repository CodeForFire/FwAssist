<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:FwAssist.Helpers.RthLandeplatz;assembly=FwAssist.Helpers.RthLandeplatz"
             x:Class="FwAssist.Helpers.RthLandeplatz.Ui.Drawings.AnnaeherungHangDrawing"
             x:DataType="vm:SiteDrawing">
  <!-- Our own section, new work from the fact on Folie 39. -->
  <Viewbox Stretch="Uniform">
    <Canvas Width="360" Height="240">
      <Path Classes="d-hill" Data="M0,226 L360,106 V240 H0 Z" />
      <Path Classes="d-slope" Data="M0,226 L360,106" />
      <Path Classes="d-heli-body" Canvas.Left="105.5" Canvas.Top="80" Width="121" Height="88" Stretch="Uniform" RenderTransform="rotate(-18.4deg)" />
      <Path Classes="d-rotor" Data="M81,84 H213" />
      <Path Classes="d-dim" Data="M76,90 H86 M81,90 V197 M76,197 H86" />
      <Path Classes="d-dim" Data="M208,90 H218 M213,90 V153 M208,153 H218" />
      <Path Classes="d-person" Canvas.Left="20" Canvas.Top="198" Width="12" Height="22" Stretch="Uniform" />
      <Path Classes="d-go" Data="M38,208 L72,196 M65.7,202.4 L72,196 L63.1,195.0" />
      <TextBlock Classes="d" Canvas.Left="2" Canvas.Top="92" Text="Talseite" />
      <TextBlock Classes="d-small" Canvas.Left="2" Canvas.Top="110" Text="Rotor weiter" />
      <TextBlock Classes="d-small" Canvas.Left="2" Canvas.Top="126" Text="vom Boden" />
      <Path Classes="d-cross" Data="M262,92 L282,112 M282,92 L262,112" />
      <TextBlock Classes="d-danger" Canvas.Left="250" Canvas.Top="40" Text="Bergseite" />
      <TextBlock Classes="d-danger" Canvas.Left="250" Canvas.Top="58" Text="nicht nähern" />
    </Canvas>
  </Viewbox>
</UserControl>
