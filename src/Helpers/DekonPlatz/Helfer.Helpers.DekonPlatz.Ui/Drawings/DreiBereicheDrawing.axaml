<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Helfer.Helpers.DekonPlatz;assembly=Helfer.Helpers.DekonPlatz"
             x:Class="Helfer.Helpers.DekonPlatz.Ui.Drawings.DreiBereicheDrawing"
             x:DataType="vm:SiteDrawing">
  <!-- Our own plan, new work from the facts in TK and the maintainer's notes in #25. Every zone says its colour in words. -->
  <Viewbox Stretch="Uniform">
    <Canvas Width="400" Height="232">
      <TextBlock Classes="d-small" Canvas.Left="340" Canvas.Top="2" Text="Wind" />
      <Path Classes="d-wind" Data="M335,12 L270,12 M278,8 L270,12 L278,16" />

      <TextBlock Classes="d-danger" Canvas.Left="4" Canvas.Top="30" Text="Gefahren-" />
      <TextBlock Classes="d-danger" Canvas.Left="4" Canvas.Top="48" Text="bereich" />
      <Path Classes="d-border" Data="M100,26 V218" />

      <TextBlock Canvas.Left="175" Canvas.Top="32" Width="100" TextAlignment="Center" Text="Eingang" />
      <Path Classes="d-go" Data="M300,62 L150,62 M158,57 L150,62 L158,67" />

      <Path Classes="d-rot" Data="M100,83 H183 V194 H100 Z" />
      <Path Classes="d-gelb" Data="M183,83 H266 V194 H183 Z" />
      <Path Classes="d-gruen" Data="M266,83 H350 V194 H266 Z" />
      <Path Classes="d-outline" Data="M100,83 H350 V194 H100 Z" />

      <Path Classes="d-box" Data="M4,90 H92 V128 H4 Z" />
      <TextBlock Classes="d-small" Canvas.Left="4" Canvas.Top="92" Width="88" TextAlignment="Center" Text="Geräte-" />
      <TextBlock Classes="d-small" Canvas.Left="4" Canvas.Top="109" Width="88" TextAlignment="Center" Text="ablage" />
      <Path Classes="d-box" Data="M4,138 H92 V190 H4 Z" />
      <TextBlock Classes="d-small" Canvas.Left="4" Canvas.Top="147" Width="88" TextAlignment="Center" Text="Abwasser-" />
      <TextBlock Classes="d-small" Canvas.Left="4" Canvas.Top="164" Width="88" TextAlignment="Center" Text="behälter" />

      <TextBlock Classes="d-zone-name" Canvas.Left="100" Canvas.Top="85" Width="83" TextAlignment="Center" Text="ROT" />
      <TextBlock Classes="d-small" Canvas.Left="100" Canvas.Top="104" Width="83" TextAlignment="Center" Text="Warten" />
      <Path Classes="d-item-light" Data="M104,128 H146 V158 H104 Z" />
      <TextBlock Classes="d-small" Canvas.Left="104" Canvas.Top="134" Width="42" TextAlignment="Center" Text="Gerät" />
      <Path Classes="d-item-light" Data="M152,146 A13,13 0 1 0 178,146 A13,13 0 1 0 152,146 Z" />
      <TextBlock Classes="d-small" Canvas.Left="134" Canvas.Top="160" Width="50" TextAlignment="Center" Text="Schuhe" />

      <TextBlock Classes="d-zone-name d-ink" Canvas.Left="183" Canvas.Top="85" Width="83" TextAlignment="Center" Text="GELB" />
      <TextBlock Classes="d-small d-ink" Canvas.Left="183" Canvas.Top="102" Width="83" TextAlignment="Center" Text="Sack" />
      <Path Classes="d-item-ink" Data="M195,150 A30,30 0 1 0 255,150 A30,30 0 1 0 195,150 Z" />
      <TextBlock Classes="d-ink" Canvas.Left="195" Canvas.Top="141" Width="60" TextAlignment="Center" Text="Wanne" />

      <TextBlock Classes="d-zone-name d-ink" Canvas.Left="266" Canvas.Top="85" Width="84" TextAlignment="Center" Text="GRÜN" />
      <TextBlock Classes="d-small d-ink" Canvas.Left="266" Canvas.Top="110" Width="84" TextAlignment="Center" Text="Doku" />
      <TextBlock Classes="d-small d-ink" Canvas.Left="266" Canvas.Top="140" Width="84" TextAlignment="Center" Text="Erst-Hilfe-" />
      <TextBlock Classes="d-small d-ink" Canvas.Left="266" Canvas.Top="157" Width="84" TextAlignment="Center" Text="Material" />

      <Path Classes="d-hose" Data="M196,176 C170,198 128,198 94,176 M102,177 L94,176 L98,184" />

      <Path Classes="d-dim" Data="M100,206 H350 M106,202 L100,206 L106,210 M344,202 L350,206 L344,210" />
      <TextBlock Classes="d-small" Canvas.Left="100" Canvas.Top="211" Width="250" TextAlignment="Center" Text="9 m" />
      <Path Classes="d-dim" Data="M362,30 V81 M358,36 L362,30 L366,36 M358,75 L362,81 L366,75" />
      <TextBlock Classes="d-small" Canvas.Left="368" Canvas.Top="46" Text="2 m" />
      <Path Classes="d-dim" Data="M362,85 V192 M358,91 L362,85 L366,91 M358,186 L362,192 L366,186" />
      <TextBlock Classes="d-small" Canvas.Left="368" Canvas.Top="130" Text="4 m" />
    </Canvas>
  </Viewbox>
</UserControl>
