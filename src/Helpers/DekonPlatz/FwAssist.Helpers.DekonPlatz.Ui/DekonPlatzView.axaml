<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:FwAssist.Helpers.DekonPlatz;assembly=FwAssist.Helpers.DekonPlatz"
             xmlns:ui="clr-namespace:FwAssist.Helpers.DekonPlatz.Ui"
             x:Class="FwAssist.Helpers.DekonPlatz.Ui.DekonPlatzView"
             x:DataType="vm:DekonPlatzViewModel">
  <UserControl.Styles>
    <StyleInclude Source="avares://FwAssist.Helpers.DekonPlatz.Ui/Drawings/DrawingStyles.axaml" />
    <Style Selector="TextBlock.heading">
      <Setter Property="FontSize" Value="18" />
    </Style>
    <Style Selector="TextBlock.line">
      <Setter Property="FontSize" Value="15" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
  </UserControl.Styles>

  <UserControl.DataTemplates>
    <ui:DrawingTemplate />
  </UserControl.DataTemplates>

  <!-- The Stufe switch sits at the bottom, in thumb reach. RadioButtons: a screen reader hears which
       Stufe is selected. -->
  <DockPanel Margin="16">
    <Grid DockPanel.Dock="Bottom" ColumnDefinitions="*,8,*,8,*" Margin="0,12,0,0">
      <RadioButton x:Name="StufeEins" Grid.Column="0" GroupName="Stufe" Content="STUFE I"
                   HorizontalAlignment="Stretch"
                   IsChecked="{Binding IsStufeEins}"
                   IsCheckedChanged="OnStufeChanged" />
      <RadioButton x:Name="StufeZwei" Grid.Column="2" GroupName="Stufe" Content="STUFE II"
                   HorizontalAlignment="Stretch"
                   IsChecked="{Binding IsStufeZwei}"
                   IsCheckedChanged="OnStufeChanged" />
      <RadioButton x:Name="StufeDrei" Grid.Column="4" GroupName="Stufe" Content="STUFE III"
                   HorizontalAlignment="Stretch"
                   IsChecked="{Binding IsStufeDrei}"
                   IsCheckedChanged="OnStufeChanged" />
    </Grid>

    <ScrollViewer x:Name="Scroller">
      <StackPanel Spacing="20">
        <ItemsControl x:Name="Sections" ItemsSource="{Binding Sections}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <StackPanel Spacing="20" />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:Section">
              <StackPanel Spacing="6">
                <TextBlock Classes="display heading" Text="{Binding Title}" />
                <ItemsControl ItemsSource="{Binding Lines}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:Line">
                      <TextBlock Classes="line" Margin="0,3" Text="{Binding Text}" />
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
                <ItemsControl ItemsSource="{Binding Drawings}" MaxWidth="520">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                      <StackPanel Spacing="12" Margin="0,6,0,0" />
                    </ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                </ItemsControl>
              </StackPanel>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

        <StackPanel x:Name="SourceList" Spacing="4">
          <TextBlock Classes="overline" Text="QUELLEN" />
          <ItemsControl ItemsSource="{x:Static vm:Dekonvorgaben.Sources}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="x:String">
                <TextBlock Classes="secondary" TextWrapping="Wrap" Margin="0,2" Text="{Binding}" />
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <TextBlock Classes="secondary" TextWrapping="Wrap" Text="{x:Static vm:Dekonvorgaben.SourceNote}" />
        </StackPanel>
      </StackPanel>
    </ScrollViewer>
  </DockPanel>
</UserControl>
