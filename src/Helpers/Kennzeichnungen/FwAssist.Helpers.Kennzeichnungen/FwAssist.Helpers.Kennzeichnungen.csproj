<Project Sdk="Microsoft.NET.Sdk">

  <!-- The Kennzeichnungen rules, content and view model. Like AppLogic, no Avalonia: its views live in
       FwAssist.Helpers.Kennzeichnungen.Ui. A helper references Core and AppLogic, never another helper. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\FwAssist.Core\FwAssist.Core.csproj" />
    <ProjectReference Include="..\..\..\FwAssist.AppLogic\FwAssist.AppLogic.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" />
  </ItemGroup>

  <!-- The tests read a small TSV through TabelleA.Parse, so every rule of the reader is covered
       without the bundled table, which loads only once per process. -->
  <ItemGroup>
    <InternalsVisibleTo Include="FwAssist.Helpers.Kennzeichnungen.Tests" />
  </ItemGroup>

  <!-- ADR Tabelle A, written by scripts/gefahrgut/extract_tabelle_a.py. Bundled, never downloaded:
       the lookup works offline and needs no permission. -->
  <ItemGroup>
    <EmbeddedResource Include="TabelleA.tsv" LogicalName="FwAssist.Helpers.Kennzeichnungen.TabelleA.tsv" />
  </ItemGroup>

</Project>
