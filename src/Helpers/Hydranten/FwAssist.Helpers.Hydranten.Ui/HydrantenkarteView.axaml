<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:FwAssist.Helpers.Hydranten;assembly=FwAssist.Helpers.Hydranten"
             xmlns:geo="clr-namespace:FwAssist.Core.Map;assembly=FwAssist.Core"
             xmlns:wp="clr-namespace:FwAssist.AppLogic.Services.Map;assembly=FwAssist.AppLogic"
             xmlns:map="clr-namespace:FwAssist.Ui.Map;assembly=FwAssist.Ui"
             x:Class="FwAssist.Helpers.Hydranten.Ui.HydrantenkarteView"
             x:DataType="vm:HydrantenkarteViewModel">
  <UserControl.Styles>
    <!-- The Einsatzstelle, as in Lagebuch: a pin whose head reads "ESt" and whose tip is the spot.
         The panel is twice the pin's height with the tip at its centre, because MapMarkerPanel
         centres a mark on its spot. Taps go through it to the map. -->
    <Style Selector="Panel.est-pin">
      <Setter Property="Width" Value="40" />
      <Setter Property="Height" Value="96" />
      <Setter Property="IsHitTestVisible" Value="False" />
    </Style>
    <Style Selector="Panel.est-pin > Path">
      <Setter Property="Fill" Value="{StaticResource SignalBrush}" />
      <Setter Property="Stroke" Value="White" />
      <Setter Property="StrokeThickness" Value="2.5" />
      <Setter Property="StrokeJoin" Value="Round" />
      <Setter Property="HorizontalAlignment" Value="Left" />
      <Setter Property="VerticalAlignment" Value="Top" />
    </Style>
    <Style Selector="Panel.est-pin > TextBlock">
      <Setter Property="Foreground" Value="White" />
      <Setter Property="FontWeight" Value="Bold" />
      <Setter Property="FontSize" Value="13" />
      <Setter Property="HorizontalAlignment" Value="Center" />
      <Setter Property="VerticalAlignment" Value="Top" />
      <Setter Property="Margin" Value="0,8,0,0" />
    </Style>
    <!-- What floats over the light day map keeps the map's colours, not the app's dark ones. -->
    <Style Selector="Border#Attribution">
      <Setter Property="Background" Value="#CCFFFFFF" />
    </Style>
    <Style Selector="Border#Attribution TextBlock">
      <Setter Property="Foreground" Value="#FF333333" />
      <Setter Property="FontSize" Value="10" />
    </Style>
    <Style Selector="Border.map-banner">
      <Setter Property="Background" Value="{StaticResource SurfaceRaisedBrush}" />
      <Setter Property="BorderBrush" Value="{StaticResource BorderStrongBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="Padding" Value="12,8" />
      <Setter Property="Margin" Value="8" />
    </Style>
    <Style Selector="Button.zoom">
      <Setter Property="Width" Value="{StaticResource ControlHeight}" />
      <Setter Property="FontSize" Value="22" />
      <Setter Property="Padding" Value="0" />
    </Style>
    <Style Selector="Button.zoom PathIcon">
      <Setter Property="Width" Value="22" />
      <Setter Property="Height" Value="22" />
    </Style>
    <!-- Where MEIN STANDORT found the phone: a blue dot, never taken for the red ESt pin. -->
    <Style Selector="Ellipse.standort-dot">
      <Setter Property="Width" Value="18" />
      <Setter Property="Height" Value="18" />
      <Setter Property="Fill" Value="{StaticResource IncomingBrush}" />
      <Setter Property="Stroke" Value="White" />
      <Setter Property="StrokeThickness" Value="3" />
    </Style>
  </UserControl.Styles>

  <!-- The map fills the page; what the user taps sits at the bottom, in thumb reach. -->
  <Grid RowDefinitions="*,Auto">
    <Grid x:Name="MapArea" Grid.Row="0" ClipToBounds="True">
      <map:MapCanvasControl x:Name="Map"
                            AutomationProperties.Name="Hydrantenkarte"
                            TileSource="{Binding Map.TileSource}"
                            WaterPoints="{Binding Hydranten}"
                            SelectedWaterPoint="{Binding Selected}"
                            Center="{Binding Map.Center}"
                            Zoom="{Binding Map.Zoom}"
                            Rotation="{Binding Map.Rotation}"
                            ViewChangedCommand="{Binding Map.ChangeViewCommand}"
                            TappedCommand="{Binding TapCommand}" />

      <!-- Beneath the ESt pin, so the pin stays readable where the two meet. -->
      <ItemsControl x:Name="StandortDot" ItemsSource="{Binding StandortMarks}" IsHitTestVisible="False">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate x:DataType="vm:HydrantenkarteViewModel">
            <map:MapMarkerPanel Center="{Binding Map.Center}" Zoom="{Binding Map.Zoom}" Rotation="{Binding Map.Rotation}" />
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.Styles>
          <Style Selector="ItemsControl#StandortDot > ContentPresenter" x:DataType="geo:GeoPoint">
            <Setter Property="map:MapMarkerPanel.Position" Value="{Binding}" />
          </Style>
        </ItemsControl.Styles>
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="geo:GeoPoint">
            <Ellipse Classes="standort-dot" />
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>

      <ItemsControl x:Name="EinsatzstellePin" ItemsSource="{Binding EinsatzstelleMarks}" IsHitTestVisible="False">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate x:DataType="vm:HydrantenkarteViewModel">
            <map:MapMarkerPanel Center="{Binding Map.Center}" Zoom="{Binding Map.Zoom}" Rotation="{Binding Map.Rotation}" />
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.Styles>
          <Style Selector="ItemsControl#EinsatzstellePin > ContentPresenter" x:DataType="geo:GeoPoint">
            <Setter Property="map:MapMarkerPanel.Position" Value="{Binding}" />
          </Style>
        </ItemsControl.Styles>
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="geo:GeoPoint">
            <Panel Classes="est-pin">
              <Path Data="M20,48 L5.8,26.3 A17,17 0 1 1 34.2,26.3 Z" />
              <TextBlock Text="ESt" />
            </Panel>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>

      <Border x:Name="StatusBanner" Classes="map-banner" VerticalAlignment="Top" HorizontalAlignment="Stretch"
              IsVisible="{Binding Status, Converter={x:Static ObjectConverters.IsNotNull}}">
        <TextBlock x:Name="StatusText" Text="{Binding Status}" TextWrapping="Wrap" />
      </Border>

      <StackPanel VerticalAlignment="Bottom" HorizontalAlignment="Right" Margin="8,8,8,28" Spacing="8">
        <!-- Drawn for this app: a ring with four ticks and a centre dot, filled even-odd. -->
        <Button x:Name="Standort" Classes="zoom" Command="{Binding StandortZeigenCommand}"
                IsVisible="{Binding CanGuide}" AutomationProperties.Name="Mein Standort">
          <PathIcon Data="F0 M12,5 A7,7 0 1 0 12,19 A7,7 0 1 0 12,5 Z M12,7 A5,5 0 1 1 12,17 A5,5 0 1 1 12,7 Z M11,1 H13 V5 H11 Z M11,19 H13 V23 H11 Z M1,11 H5 V13 H1 Z M19,11 H23 V13 H19 Z M12,10 A2,2 0 1 0 12,14 A2,2 0 1 0 12,10 Z" />
        </Button>
        <Button x:Name="ZoomIn" Classes="zoom" Content="+" Command="{Binding Map.ZoomInCommand}"
                AutomationProperties.Name="Vergrößern" />
        <Button x:Name="ZoomOut" Classes="zoom" Content="−" Command="{Binding Map.ZoomOutCommand}"
                AutomationProperties.Name="Verkleinern" />
      </StackPanel>

      <Border x:Name="Attribution" VerticalAlignment="Bottom" HorizontalAlignment="Left" Padding="4,1"
              IsVisible="{Binding Map.Attribution, Converter={x:Static ObjectConverters.IsNotNull}}">
        <TextBlock Text="{Binding Map.Attribution}" TextWrapping="Wrap" />
      </Border>
    </Grid>

    <StackPanel Grid.Row="1" Margin="12" Spacing="8">
      <!-- The open hydrant's card. -->
      <Border x:Name="HydrantCard" Classes="map-banner" Margin="0" IsVisible="{Binding HasSelected}">
        <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto">
          <TextBlock Grid.Column="0" Classes="overline" Text="{Binding Selected.Title, FallbackValue=''}"
                     VerticalAlignment="Center" />
          <Button Grid.Column="1" Classes="ghost" Content="SCHLIESSEN" Command="{Binding KarteSchliessenCommand}" />
          <Button x:Name="PfeilStarten" Grid.Row="2" Grid.ColumnSpan="2" Classes="signal" Margin="0,8,0,0"
                  HorizontalAlignment="Stretch" Content="PFEIL ZUM HYDRANTEN"
                  Command="{Binding PfeilStartenCommand}" IsVisible="{Binding CanGuide}" />
          <ItemsControl Grid.Row="1" Grid.ColumnSpan="2" ItemsSource="{Binding Selected.Details, FallbackValue={x:Null}}"
                        Grid.IsSharedSizeScope="True">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="wp:WaterPointDetail">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" SharedSizeGroup="DetailLabel" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>
                  <TextBlock Grid.Column="0" Classes="secondary" Text="{Binding Label}" Margin="0,0,12,0" />
                  <TextBlock Grid.Column="1" Text="{Binding Value}" TextWrapping="Wrap" />
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </Grid>
      </Border>

      <!-- The nearest hydrants: tapping one is the user's choice. -->
      <StackPanel x:Name="NearestList" Spacing="6" IsVisible="{Binding HasNearest}">
        <Grid ColumnDefinitions="*,Auto">
          <TextBlock Classes="overline" Text="WELCHEN HYDRANTEN NEHMEN?" VerticalAlignment="Center" />
          <Button Grid.Column="1" Classes="ghost" Content="SCHLIESSEN" Command="{Binding ListeSchliessenCommand}" />
        </Grid>
        <ItemsControl x:Name="NearestRows" ItemsSource="{Binding Nearest}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <StackPanel Spacing="6" />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:HydrantRow">
              <Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                      Command="{Binding $parent[ItemsControl].((vm:HydrantenkarteViewModel)DataContext).WaehleCommand}"
                      CommandParameter="{Binding}">
                <StackPanel>
                  <TextBlock Text="{Binding Bauart}" FontWeight="SemiBold" />
                  <TextBlock Classes="secondary" Text="{Binding Text}" />
                </StackPanel>
              </Button>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>

      <Button x:Name="CancelMove" HorizontalAlignment="Stretch" Content="ABBRECHEN"
              Command="{Binding VerschiebenAbbrechenCommand}"
              IsVisible="{Binding IsMoving}" />
      <StackPanel Spacing="8" IsVisible="{Binding !IsPlacing}">
        <Button x:Name="Nearest" Classes="signal" HorizontalAlignment="Stretch" Content="NÄCHSTE HYDRANTEN"
                Command="{Binding NaechsteHydrantenCommand}" />
        <Grid ColumnDefinitions="*,12,*">
          <Button Grid.Column="0" HorizontalAlignment="Stretch" Content="ESt VERSCHIEBEN"
                  Command="{Binding EinsatzstelleVerschiebenCommand}" />
          <Button Grid.Column="2" HorizontalAlignment="Stretch" Content="ESt LÖSCHEN"
                  Command="{Binding EinsatzstelleLoeschenCommand}" />
        </Grid>
      </StackPanel>
    </StackPanel>

    <!-- The Richtungspfeil covers the whole page while it guides: one large arrow from the phone to
         the hydrant, the distance under it, and BEENDEN in thumb reach. The arrow turns with the
         compass, so it points the right way however the phone is held. -->
    <Panel Grid.RowSpan="2" IsVisible="{Binding HasPfeil}" Background="{StaticResource SurfaceBrush}">
      <Grid x:Name="Richtungspfeil" DataContext="{Binding Pfeil}" x:DataType="vm:RichtungspfeilViewModel"
            RowDefinitions="Auto,*,Auto,Auto,Auto,Auto" Margin="16">
        <TextBlock Grid.Row="0" HorizontalAlignment="Center" FontSize="18" Text="{Binding Target.Title, StringFormat='Zum {0}'}" />
        <Viewbox Grid.Row="1" Stretch="Uniform" MaxWidth="320" MaxHeight="320" Margin="0,16">
          <Path x:Name="Arrow" Width="200" Height="200" Fill="{StaticResource SignalBrush}"
                Stroke="White" StrokeThickness="4" StrokeJoin="Round"
                Data="M100,8 L172,120 L122,120 L122,192 L78,192 L78,120 L28,120 Z"
                IsVisible="{Binding ShowsArrow}"
                AutomationProperties.Name="{Binding DirectionText}"
                RenderTransformOrigin="50%,50%">
            <Path.RenderTransform>
              <RotateTransform Angle="{Binding ArrowAngle}" />
            </Path.RenderTransform>
          </Path>
        </Viewbox>
        <TextBlock x:Name="Distance" Grid.Row="2" Classes="metric" HorizontalAlignment="Center"
                   Text="{Binding DistanceText}" IsVisible="{Binding DistanceText, Converter={x:Static ObjectConverters.IsNotNull}}" />
        <TextBlock x:Name="Direction" Grid.Row="3" HorizontalAlignment="Center" FontSize="20"
                   Text="{Binding DirectionText}" IsVisible="{Binding DirectionText, Converter={x:Static ObjectConverters.IsNotNull}}" />
        <StackPanel Grid.Row="4" Spacing="4" Margin="0,8">
          <TextBlock x:Name="PfeilStatus" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" FontSize="18"
                     Text="{Binding Status}" IsVisible="{Binding Status, Converter={x:Static ObjectConverters.IsNotNull}}" />
          <TextBlock Classes="secondary" HorizontalAlignment="Center" Text="{Binding AccuracyText}"
                     IsVisible="{Binding AccuracyText, Converter={x:Static ObjectConverters.IsNotNull}}" />
        </StackPanel>
        <Button x:Name="PfeilBeenden" Grid.Row="5" HorizontalAlignment="Stretch" Content="BEENDEN"
                Command="{Binding $parent[UserControl].((vm:HydrantenkarteViewModel)DataContext).PfeilBeendenCommand}" />
      </Grid>
    </Panel>
  </Grid>
</UserControl>
