<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:FwAssist.Helpers.Gefahrgut;assembly=FwAssist.Helpers.Gefahrgut"
             x:Class="FwAssist.Helpers.Gefahrgut.Ui.GefahrgutView"
             x:DataType="vm:GefahrgutViewModel">
  <UserControl.Resources>
    <!-- The plate's own colours, as Kennzeichnungen draws them: orange with black numbers is what
         a crew sees on the vehicle, so these are not theme tokens. The numbers carry the meaning;
         the colour only makes the plate recognisable. -->
    <SolidColorBrush x:Key="WarntafelBrush" Color="#F7941E" />
    <SolidColorBrush x:Key="WarntafelInkBrush" Color="#000000" />
  </UserControl.Resources>

  <UserControl.Styles>
    <Style Selector="TextBlock.line">
      <Setter Property="FontSize" Value="15" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style Selector="TextBlock.plate">
      <Setter Property="Foreground" Value="{StaticResource WarntafelInkBrush}" />
      <Setter Property="FontSize" Value="20" />
      <Setter Property="FontWeight" Value="Bold" />
      <Setter Property="HorizontalAlignment" Value="Center" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
  </UserControl.Styles>

  <!-- The field stays at the top and the list scrolls under it, so the soft keyboard never covers
       what is being typed. -->
  <DockPanel Margin="16">
    <!-- A UN-Nummer is typed as read off the plate, so the keyboard may not correct it. -->
    <Grid DockPanel.Dock="Top" ColumnDefinitions="*,8,Auto">
      <TextBox x:Name="Search" Grid.Column="0" MaxLength="60"
               PlaceholderText="UN-Nummer oder Stoff"
               AutomationProperties.Name="UN-Nummer von der Warntafel oder Name des Stoffs"
               TextInputOptions.ShowSuggestions="False"
               TextInputOptions.AutoCapitalization="False"
               Text="{Binding Query}" />
      <Button x:Name="ClearButton" Grid.Column="2" Content="LÖSCHEN" Command="{Binding ClearCommand}" />
    </Grid>

    <ScrollViewer x:Name="Scroller" Margin="0,12,0,0">
      <StackPanel Spacing="16">
        <TextBlock x:Name="Hint" Classes="line" IsVisible="{Binding !IsSearching}"
                   Text="Die untere Nummer der orangen Warntafel eingeben, die UN-Nummer. Oder einen Teil des Stoffnamens." />
        <TextBlock x:Name="NoHits" Classes="line" IsVisible="{Binding HasNoHits}"
                   Text="Nichts gefunden. Nummer auf der Tafel noch einmal prüfen oder anderen Namen versuchen." />
        <TextBlock x:Name="ResultTitle" Classes="overline" TextWrapping="Wrap"
                   IsVisible="{Binding HasResults}" Text="{Binding ResultTitle}" />

        <ItemsControl x:Name="Results" ItemsSource="{Binding Results}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <StackPanel Spacing="16" />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:Stoff">
              <Grid ColumnDefinitions="96,12,*">
                <!-- The Warntafel as it hangs on the vehicle: Gefahrnummer over UN-Nummer. -->
                <Border Grid.Column="0" Width="96" Height="64" VerticalAlignment="Top"
                        Background="{StaticResource WarntafelBrush}"
                        BorderBrush="{StaticResource WarntafelInkBrush}" BorderThickness="3">
                  <Grid RowDefinitions="*,3,*">
                    <TextBlock Grid.Row="0" Classes="plate mono" Text="{Binding Tafel}" />
                    <Rectangle Grid.Row="1" Fill="{StaticResource WarntafelInkBrush}" />
                    <TextBlock Grid.Row="2" Classes="plate mono" Text="{Binding UnNummer}" />
                  </Grid>
                </Border>
                <StackPanel Grid.Column="2" Spacing="2">
                  <TextBlock Classes="line" FontWeight="SemiBold" Text="{Binding Benennung}" />
                  <TextBlock Classes="secondary" TextWrapping="Wrap" Text="{Binding Merkmale}" />
                </StackPanel>
              </Grid>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

        <TextBlock x:Name="MoreNote" Classes="line" IsVisible="{Binding HasMore}" Text="{Binding MoreNote}" />

        <StackPanel x:Name="SourceList" Spacing="4">
          <TextBlock Classes="overline" Text="QUELLE" />
          <TextBlock Classes="secondary" TextWrapping="Wrap" Text="{x:Static vm:TabelleA.Source}" />
          <TextBlock Classes="secondary" TextWrapping="Wrap" Text="{x:Static vm:TabelleA.SourceNote}" />
        </StackPanel>
      </StackPanel>
    </ScrollViewer>
  </DockPanel>
</UserControl>
