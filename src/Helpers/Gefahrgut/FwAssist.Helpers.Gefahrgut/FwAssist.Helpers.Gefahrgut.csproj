<Project Sdk="Microsoft.NET.Sdk">

  <!-- The Gefahrgut lookup's data and view models. Like AppLogic, no Avalonia: its views live in
       FwAssist.Helpers.Gefahrgut.Ui. A helper references Core and AppLogic, never another helper. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\FwAssist.Core\FwAssist.Core.csproj" />
    <ProjectReference Include="..\..\..\FwAssist.AppLogic\FwAssist.AppLogic.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" />
  </ItemGroup>

  <!-- ADR Tabelle A, written by scripts/gefahrgut/extract_tabelle_a.py. Bundled, never downloaded:
       the lookup works offline and needs no permission. -->
  <ItemGroup>
    <EmbeddedResource Include="TabelleA.tsv" LogicalName="FwAssist.Helpers.Gefahrgut.TabelleA.tsv" />
  </ItemGroup>

</Project>
