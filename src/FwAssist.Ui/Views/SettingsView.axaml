<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:FwAssist.AppLogic.ViewModels;assembly=FwAssist.AppLogic"
             x:Class="FwAssist.Ui.Views.SettingsView"
             x:DataType="vm:SettingsViewModel">
  <ScrollViewer>
    <StackPanel Margin="16" Spacing="12">
      <TextBlock Classes="overline" Text="EIGENES SYMBOL AUF DEM STARTBILDSCHIRM" TextWrapping="Wrap" />
      <TextBlock Classes="secondary" TextWrapping="Wrap"
                 Text="Ein Helfer mit eigenem Symbol öffnet sich mit einem Tipp direkt." />
      <TextBlock x:Name="Error" Classes="field-error" Text="{Binding Error}"
                 IsVisible="{Binding Error, Converter={x:Static ObjectConverters.IsNotNull}}" />
      <ItemsControl x:Name="LauncherIcons" ItemsSource="{Binding LauncherIcons}">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:LauncherIconToggleViewModel">
            <Border BorderBrush="{StaticResource HairlineBrush}" BorderThickness="0,0,0,1" Padding="0,4">
              <Grid ColumnDefinitions="*,Auto" MinHeight="{StaticResource ControlHeight}">
                <TextBlock Grid.Column="0" Text="{Binding Title}" VerticalAlignment="Center" />
                <ToggleSwitch Grid.Column="1" IsChecked="{Binding IsEnabled}"
                              OnContent="" OffContent=""
                              AutomationProperties.Name="{Binding Title}" />
              </Grid>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>

      <!-- The order of the helpers on the overview: arrows, not drag and drop, so it works with gloves. -->
      <Panel IsVisible="{Binding Order, Converter={x:Static ObjectConverters.IsNotNull}}">
        <StackPanel x:Name="HelperOrder" Spacing="12" Margin="0,12,0,0" DataContext="{Binding Order}"
                    x:DataType="vm:HelperOrderSection">
          <TextBlock Classes="overline" Text="REIHENFOLGE IN DER ÜBERSICHT" TextWrapping="Wrap" />
          <TextBlock Classes="secondary" TextWrapping="Wrap"
                     Text="Mit den Pfeilen nach oben oder unten schieben." />
          <ItemsControl x:Name="HelperOrderRows" ItemsSource="{Binding Rows}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:HelperOrderRow">
                <Border BorderBrush="{StaticResource HairlineBrush}" BorderThickness="0,0,0,1" Padding="0,4">
                  <Grid ColumnDefinitions="*,Auto,8,Auto" MinHeight="{StaticResource ControlHeight}">
                    <TextBlock Grid.Column="0" Text="{Binding Title}" VerticalAlignment="Center" TextWrapping="Wrap" />
                    <Button Grid.Column="1" Classes="icon-btn" Command="{Binding MoveUpCommand}"
                            AutomationProperties.Name="{Binding MoveUpName}">
                      <PathIcon Data="M12,7 L19,14 L17.6,15.4 L12,9.8 L6.4,15.4 L5,14 Z" />
                    </Button>
                    <Button Grid.Column="3" Classes="icon-btn" Command="{Binding MoveDownCommand}"
                            AutomationProperties.Name="{Binding MoveDownName}">
                      <PathIcon Data="M12,17 L5,10 L6.4,8.6 L12,14.2 L17.6,8.6 L19,10 Z" />
                    </Button>
                  </Grid>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <Button x:Name="ResetOrder" HorizontalAlignment="Stretch" Content="REIHENFOLGE ZURÜCKSETZEN"
                  Command="{Binding ResetCommand}" />
        </StackPanel>
      </Panel>

      <!-- The Kartenpakete: on this device, and on offer once the user asks for the list. -->
      <Panel IsVisible="{Binding Maps, Converter={x:Static ObjectConverters.IsNotNull}}">
        <StackPanel x:Name="MapPacks" Spacing="12" Margin="0,12,0,0" DataContext="{Binding Maps}"
                    x:DataType="vm:MapPacksSection">
          <TextBlock Classes="overline" Text="KARTENPAKETE" />
          <TextBlock Classes="secondary" TextWrapping="Wrap"
                     Text="Für die Hydrantenkarte. Ein Paket je Landkreis, etwa 100 MB – am besten im WLAN laden. Bisher nur Bayern." />
          <TextBlock x:Name="MapPacksSummary" Text="{Binding Summary}" />
          <Button x:Name="LoadCatalog" HorizontalAlignment="Stretch" Content="LISTE LADEN"
                  Command="{Binding LoadCatalogCommand}" />
          <TextBlock x:Name="MapPacksStatus" Classes="secondary" TextWrapping="Wrap" Text="{Binding Status}"
                     IsVisible="{Binding Status, Converter={x:Static ObjectConverters.IsNotNull}}" />

          <Border x:Name="ConfirmRemove" BorderBrush="{StaticResource BorderStrongBrush}" BorderThickness="1" Padding="12"
                  IsVisible="{Binding Removing, Converter={x:Static ObjectConverters.IsNotNull}}">
            <StackPanel Spacing="8">
              <TextBlock TextWrapping="Wrap" Text="{Binding Removing.Name, StringFormat='„{0}“ vom Gerät löschen?'}" />
              <Grid ColumnDefinitions="*,12,*">
                <Button Grid.Column="0" Classes="signal" HorizontalAlignment="Stretch" Content="WIRKLICH LÖSCHEN"
                        Command="{Binding ConfirmRemoveCommand}" />
                <Button Grid.Column="2" HorizontalAlignment="Stretch" Content="BEHALTEN"
                        Command="{Binding CancelRemoveCommand}" />
              </Grid>
            </StackPanel>
          </Border>

          <ItemsControl x:Name="MapPackRows" ItemsSource="{Binding Packs}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:MapPackRow">
                <Border BorderBrush="{StaticResource HairlineBrush}" BorderThickness="0,0,0,1" Padding="0,8">
                  <StackPanel Spacing="6">
                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextWrapping="Wrap" />
                    <TextBlock Classes="secondary" Text="{Binding Detail}" IsVisible="{Binding ShowsDetail}" TextWrapping="Wrap" />
                    <TextBlock Classes="secondary" Text="{Binding UpdateReason}" TextWrapping="Wrap"
                               IsVisible="{Binding UpdateReason, Converter={x:Static ObjectConverters.IsNotNull}}" />
                    <StackPanel Spacing="6" IsVisible="{Binding IsDownloading}">
                      <ProgressBar Minimum="0" Maximum="1" Value="{Binding Progress}" AutomationProperties.Name="{Binding ProgressText}" />
                      <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Text="{Binding ProgressText}" VerticalAlignment="Center" />
                        <Button Grid.Column="1" Content="ABBRECHEN"
                                Command="{Binding $parent[ItemsControl].((vm:MapPacksSection)DataContext).CancelInstallCommand}" />
                      </Grid>
                    </StackPanel>
                    <Grid ColumnDefinitions="*,12,*">
                      <Button Grid.Column="0" HorizontalAlignment="Stretch" Content="{Binding ActionLabel}" IsVisible="{Binding ShowsAction}"
                              Command="{Binding $parent[ItemsControl].((vm:MapPacksSection)DataContext).InstallCommand}"
                              CommandParameter="{Binding}" />
                      <Button Grid.Column="2" HorizontalAlignment="Stretch" Content="LÖSCHEN" IsVisible="{Binding ShowsRemove}"
                              Command="{Binding $parent[ItemsControl].((vm:MapPacksSection)DataContext).RemoveCommand}"
                              CommandParameter="{Binding}" />
                    </Grid>
                  </StackPanel>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </Panel>
    </StackPanel>
  </ScrollViewer>
</UserControl>
