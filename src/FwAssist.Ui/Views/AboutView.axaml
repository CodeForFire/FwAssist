<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:FwAssist.AppLogic.ViewModels;assembly=FwAssist.AppLogic"
             x:Class="FwAssist.Ui.Views.AboutView"
             x:DataType="vm:AboutViewModel">
  <ScrollViewer>
    <StackPanel Margin="16" Spacing="16">
      <StackPanel Spacing="2">
        <TextBlock Classes="overline" Text="VERSION" />
        <TextBlock x:Name="Version" Classes="mono" Text="{Binding VersionText}" />
      </StackPanel>
      <TextBlock Classes="secondary" TextWrapping="Wrap" Text="Ein Projekt von CodeForFire" />
      <StackPanel Spacing="4">
        <Button x:Name="RepositoryLink" HorizontalAlignment="Stretch"
                HorizontalContentAlignment="Left"
                MinHeight="{StaticResource ControlHeight}"
                Command="{Binding OpenRepositoryCommand}"
                AutomationProperties.Name="Projekt auf GitHub öffnen">
          <TextBlock Text="{Binding RepositoryText}" TextWrapping="Wrap" />
        </Button>
        <TextBlock x:Name="Error" Classes="field-error" Text="{Binding Error}"
                   IsVisible="{Binding Error, Converter={x:Static ObjectConverters.IsNotNull}}" />
      </StackPanel>
      <TextBlock Classes="secondary" TextWrapping="Wrap" Text="Veröffentlicht unter der MIT-Lizenz." />
      <TextBlock Classes="secondary" TextWrapping="Wrap" Text="Copyright (C) 2026 Christian Arlt" />
    </StackPanel>
  </ScrollViewer>
</UserControl>
