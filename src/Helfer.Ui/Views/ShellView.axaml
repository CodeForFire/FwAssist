<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Helfer.AppLogic.ViewModels;assembly=Helfer.AppLogic"
             x:Class="Helfer.Ui.Views.ShellView"
             x:DataType="vm:ShellViewModel"
             Background="{StaticResource AppBackgroundBrush}">
  <DockPanel>
    <!-- The signal strip Lagebuch's header carries, so the two apps read as one family. -->
    <Border DockPanel.Dock="Top" Height="3" Background="{StaticResource SignalGradientBrush}" />
    <Border DockPanel.Dock="Top" Background="{StaticResource HeaderBarBrush}"
            BorderBrush="{StaticResource HairlineBrush}" BorderThickness="0,0,0,1"
            Padding="4,4,16,4">
      <Grid ColumnDefinitions="Auto,*">
        <Button x:Name="HomeButton" Grid.Column="0" Classes="icon-btn"
                IsVisible="{Binding !IsHome}" Command="{Binding GoHomeCommand}"
                AutomationProperties.Name="Zur Übersicht">
          <PathIcon Data="M20,11 H7.8 L13.4,5.4 L12,4 L4,12 L12,20 L13.4,18.6 L7.8,13 H20 Z" />
        </Button>
        <TextBlock Grid.Column="1" Classes="display" Text="{Binding Title}"
                   VerticalAlignment="Center" Margin="12,0,0,0" MinHeight="0" />
      </Grid>
    </Border>
    <ContentControl x:Name="Page" Content="{Binding Current}" />
  </DockPanel>
</UserControl>
