                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity-alias android:name="de.codeforfire.helfer.launcher.dekonplatz"
                        android:targetActivity="de.codeforfire.helfer.MainActivity"
                        android:label="Dekon-Platz"
                        android:icon="@drawable/ic_helper_dekonplatz"
