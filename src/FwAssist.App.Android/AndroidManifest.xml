        <activity-alias android:name="de.codeforfire.helfer.launcher.strahlenschutz"
                        android:targetActivity="de.codeforfire.helfer.MainActivity"
                        android:label="Strahlenschutz"
                        android:icon="@drawable/ic_helper_strahlenschutz"
