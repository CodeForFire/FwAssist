<?xml version="1.0" encoding="utf-8"?>
<!-- versionCode, versionName, package and minSdkVersion are deliberately absent: the .NET Android
     SDK fills them only when they are missing, so declaring one here would silently override the
     csproj and the release workflow (lagebuch shipped six releases as versionName 0.1.0 that way).

     MainActivity is declared here rather than by an [Activity] attribute: an activity-alias must
     come after the activity it targets, and the SDK appends attribute-generated activities to the
     end of <application>. The C# class carries [Register] with the same Java name. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-sdk android:targetSdkVersion="36" />

    <!-- The one permission, and only for the Hydrantenkarte's Kartenpakete: the list of packs and
         a pack are fetched over https when the user asks for them under Einstellungen. Nothing
         else goes online, and nothing about the user or an Einsatz is sent. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- The Hydrantenkarte's Richtungspfeil, which points from where the phone is to the chosen
         hydrant, and its Mein Standort button, which centres the map on the phone once. Asked for
         only when one of them is first used, used only while the arrow is open or the button waits
         for its fix and the app is in front, never stored and never sent. Coarse is listed with fine
         because Android 12 lets the user grant only the approximate position. -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />

    <!-- The Richtungspfeil's arrival at the hydrant: a short vibration with the tone, so a crew
         member walking with eyes on the street notices it, and still notices it on a phone set to
         vibrate. Nothing else vibrates. A normal permission: Android grants it at install, with no
         dialog, and it reads or sends nothing. -->
    <uses-permission android:name="android.permission.VIBRATE" />

    <!-- None is required: without GPS the network position serves, without a compass the arrow
         gives the Himmelsrichtung instead, and without any location only the Richtungspfeil is
         missing. The location permissions imply android.hardware.location and its .gps, so both are
         declared here; otherwise Google Play hides the app from devices that lack them, such as
         Wi-Fi-only tablets. ManifestFeatureTests holds the line. -->
    <uses-feature android:name="android.hardware.location" android:required="false" />
    <uses-feature android:name="android.hardware.location.gps" android:required="false" />
    <uses-feature android:name="android.hardware.sensor.compass" android:required="false" />
    <!-- Android's Auto Backup copies the app's data into the user's Google account. The two rule
         files keep the Einsatzstelle (helper-settings-device) and the Kartenpakete (files/maps) out
         of it: the first is Einsatz data, the second large enough to push the app past the backup
         quota, after which Android backs up nothing. data_extraction_rules is read from Android 12,
         fullBackupContent before. BackupRulesTests holds the line. -->
    <application android:label="FwAssist" android:icon="@drawable/ic_launcher"
                 android:dataExtractionRules="@xml/data_extraction_rules"
                 android:fullBackupContent="@xml/backup_rules"
                 android:theme="@style/MyTheme.NoActionBar" android:usesCleartextTraffic="false">

        <!-- singleTask: a helper's own icon brings the running app forward and arrives through
             OnNewIntent, instead of stacking a second copy of the app on top of the first. -->
        <activity android:name="de.codeforfire.helfer.MainActivity"
                  android:exported="true"
                  android:launchMode="singleTask"
                  android:windowSoftInputMode="adjustResize"
                  android:configChanges="orientation|screenSize|uiMode|screenLayout|smallestScreenSize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- One alias per helper: its own icon on the home screen, opening that helper directly.
             The name is de.codeforfire.helfer.launcher.<IHelperModule.Id>; MainActivity reads the
             helper from it and AndroidLauncherIcons switches it on and off. Renaming one removes
             the icon from every home screen it was placed on. LauncherAliasTests keeps this list
             and CompositionRoot.Modules in step. -->
        <activity-alias android:name="de.codeforfire.helfer.launcher.stoppuhr"
                        android:targetActivity="de.codeforfire.helfer.MainActivity"
                        android:label="Stoppuhr"
                        android:icon="@drawable/ic_helper_stoppuhr"
                        android:exported="true"
                        android:enabled="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity-alias android:name="de.codeforfire.helfer.launcher.funkalphabet"
                        android:targetActivity="de.codeforfire.helfer.MainActivity"
                        android:label="Buchstabieralphabet"
                        android:icon="@drawable/ic_helper_funkalphabet"
                        android:exported="true"
                        android:enabled="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity-alias android:name="de.codeforfire.helfer.launcher.schaummittel"
