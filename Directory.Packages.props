<Project>
  <!-- Central Package Management: single source of truth for package versions.
       Projects reference <PackageReference Include="..." /> without a Version attribute;
       dependabot updates versions here (one edit per package instead of per project).

       One subtree deliberately deviates and keeps its own Directory.Packages.props
       (nearest file wins; it imports this one):
         - tests/FwAssist.Acceptance.Tests     (xunit.v3 stack)
       Single-reference exceptions use VersionOverride in the .csproj. -->
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>

  <ItemGroup>
    <PackageVersion Include="Avalonia" Version="12.1.4" />
    <!-- Keep in step with Avalonia: 12.1.1 hangs destroying an Activity that is still in the
         foreground (Back from the last page, a disabled launcher alias), and the next launch then
         sticks on the splash screen. Lagebuch's separate Android props file drifted to exactly
         that version; one file here is what keeps Dependabot's Avalonia group bumping it too. -->
    <PackageVersion Include="Avalonia.Android" Version="12.1.4" />
    <PackageVersion Include="Avalonia.Fonts.Inter" Version="12.1.4" />
    <PackageVersion Include="Avalonia.Headless.XUnit" Version="12.1.4" />
    <PackageVersion Include="Avalonia.Skia" Version="12.1.4" />
    <PackageVersion Include="Avalonia.Themes.Fluent" Version="12.1.4" />
    <PackageVersion Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.11.0" />
    <PackageVersion Include="StyleCop.Analyzers" Version="1.2.0-beta.556" />
    <!-- Floors required by Avalonia.Android 12.1.x's own transitive dependency on
         Xamarin.AndroidX.AppCompat 1.7.1.3, which needs Core >= 1.17.0.2 and
         Activity >= 1.12.4.1 (checked against the AppCompat 1.7.1.3 nuspec). -->
    <PackageVersion Include="Xamarin.AndroidX.Activity" Version="1.12.4.1" />
    <PackageVersion Include="Xamarin.AndroidX.Core" Version="1.17.0.2" />
    <PackageVersion Include="xunit" Version="2.9.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="4.0.1" />
  </ItemGroup>
</Project>
